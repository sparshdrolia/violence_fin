        "valueType": "number",
        "order": "desc",
        "format": "integer",
        "period": "all_time",
        "scope": "global",
        "dedupe": "best_per_user"
      },
      "best_shift_earnings": {
        "label": "Best Shift Earnings",
        "valueType": "number",
        "order": "desc",
        "format": "integer",
        "period": "all_time",
        "scope": "global",
        "dedupe": "best_per_user"
      }
    },
    "tallies": {},
    "worlds": {}
  }
}
